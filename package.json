{
  "name": "tailor",
  "private": true,
  "description": "Tailor: fitness and wellbeing, made to measure",
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "type": "module",
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "node scripts/build.mjs && npm run build -w @tailor/web",
    "e2e": "node tests/e2e/run.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run e2e"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "@types/node": "^22.0.0"
  }
}